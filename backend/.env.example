# Server
PORT=3000
NODE_ENV=development

# JWT
JWT_SECRET=tcmp-dev-secret-change-me
JWT_ACCESS_EXPIRES=2h
JWT_REFRESH_EXPIRES=7d

# Database
DB_PATH=./data/tcmp.db

# Auth
EMAIL_DOMAIN_WHITELIST=mech-mind.net

# Uploads
UPLOAD_DIR=./uploads

# ===== Teambition 集成 =====
# 模式：REAL = 真实调用 Teambition Open API；其他值或留空 = Mock（仅本地伪造 task）
TB_MODE=MOCK
# Teambition Open Platform 基地址（一般无需改动）
TB_API_BASE=https://open.teambition.com
# 三种鉴权，按优先级由高到低：per-user OAuth > PAT > client_credentials
TB_ACCESS_TOKEN=
TB_APP_ID=
TB_APP_SECRET=
TB_ORG_ID=
# B 方案（扫码授权后以用户身份提交）必填回调地址，且 TB 应用控制台里也要填一致
TB_OAUTH_REDIRECT_URI=http://localhost:3000/api/v1/auth/tb/callback
# TB_AUTHORIZE_URL=
# TB_TOKEN_URL=
